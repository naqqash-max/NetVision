# =============================================================================
# NetVision Production Environment Configuration Template
# Instructions: Copy this file to .env.production on the staging/production host
#               and populate it with real, secure parameters.
# =============================================================================

# --- Database Credentials ---
POSTGRES_DB=netvision
POSTGRES_USER=netvision_admin
# CRITICAL: Supply a secure, unique password. Do not use default or developer keys.
POSTGRES_PASSWORD=

# --- JWT API Security ---
# CRITICAL: Generate a cryptographically secure 256-bit secret key (e.g., `openssl rand -hex 32`)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15
ENVIRONMENT=production

# --- External SMTP Relay Credentials ---
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-username@gmail.com
SMTP_PASSWORD=your-app-specific-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=NetVision Operations Center
SMTP_TLS=true
SMTP_SSL=false

# --- Client Settings ---
# URL of your production frontend application (e.g., https://netvision.yourdomain.com)
FRONTEND_URL=

# --- Monitoring Scheduler settings ---
# Limit concurrency to protect database pools and local interfaces
MONITOR_CONCURRENCY_LIMIT=10
