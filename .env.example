# NetVision Environment Variables Template
# Copy this file to .env and fill in your configuration

# Database Configuration
DATABASE_URL=postgresql://admin:supersecretpassword123@database:5432/netvision

# JWT & Security
SECRET_KEY=anothertopsysecretkey9876543210
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15

# SMTP Email Configuration
# Option 1: Real SMTP / Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=NetVision Operations Center
SMTP_TLS=true
SMTP_SSL=false
EMAIL_ENABLED=true

# Option 2: Local Mailpit (Development default)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@netvision.local
# SMTP_TLS=false

# Application URLs
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=production
